msgid "Advanced options"
msgstr "Opsyon avanse"

msgid "Flat Pages"
msgstr "Paj senp"

msgid "URL"
msgstr "URL"

msgid ""
"Example: “/about/contact/”. Make sure to have leading and trailing slashes."
msgstr ""
"Egzanp: “/about/contact/”. Asire w gen yon bar oblik nan kòmansman ak nan "
"fen."

msgid ""
"This value must contain only letters, numbers, dots, underscores, dashes, "
"slashes or tildes."
msgstr ""
"Valè sa a dwe sèlman gen lèt, chif, pwen, tirè anba, tirè, bar oblik oswa "
"tilde."

msgid "Example: “/about/contact”. Make sure to have a leading slash."
msgstr "Egzanp: “/about/contact”. Asire w gen yon bar oblik nan kòmansman."

msgid "URL is missing a leading slash."
msgstr "URL la manke yon bar oblik nan kòmansman."

msgid "URL is missing a trailing slash."
msgstr "URL la manke yon bar oblik nan fen."

#, python-format
msgid "Flatpage with url %(url)s already exists for site %(site)s"
msgstr "Paj senp ak URL %(url)s egziste deja pou sit %(site)s"

msgid "title"
msgstr "tit"

msgid "content"
msgstr "kontni"

msgid "enable comments"
msgstr "aktive kòmantè a"

msgid "template name"
msgstr "non template la"

msgid ""
"Example: “flatpages/contact_page.html”. If this isn’t provided, the system "
"will use “flatpages/default.html”."
msgstr ""
"Egzanp: “flatpages/contact_page.html”. Si sa pa bay, sistèm nan ap itilize "
"“flatpages/default.html”."

msgid "registration required"
msgstr "enskripsyon obligatwa"

msgid "If this is checked, only logged-in users will be able to view the page."
msgstr "Si sa make, se sèlman itilizatè ki konekte yo ki ap kapab wè paj la."

msgid "sites"
msgstr "sit yo"

msgid "flat page"
msgstr "paj senp"

msgid "flat pages"
msgstr "paj senp yo"
