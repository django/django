msgid "PostgreSQL extensions"
msgstr "PostgreSQL-ის გაფართოებები"

#, python-format
msgid "Item %(nth)s in the array did not validate:"
msgstr "ელემენტი %(nth)s მასივში სწორი არაა:"

msgid "Nested arrays must have the same length."
msgstr "ერთმანეთში ჩალაგებულ მასივებს ტოლი სიგრძე უნდა ჰქონდეთ."

msgid "Map of strings to strings/nulls"
msgstr "სტრიქონების ასახვა სტრიქონებზე/ნულებზე"

#, python-format
msgid "The value of “%(key)s” is not a string or null."
msgstr "“%(key)s”-ის მნიშვნელობა სტრიქონი, ან ნული არაა."

msgid "Could not load JSON data."
msgstr "JSON მონაცემების ჩატვირთვა შეუძლებელია."

msgid "Input must be a JSON dictionary."
msgstr "შეყვანა JSON ლექსიკონი უნდა იყოს."

msgid "Enter two valid values."
msgstr "შეიყვანეთ ორი სწორი მნიშვნელობა."

msgid "The start of the range must not exceed the end of the range."
msgstr "შუალედის დასაწყისი მის დასასრულზე მეტი არ უნდა იყოს."

msgid "Enter two whole numbers."
msgstr "შეიყვანეთ ორი მთელი რიცხვი."

msgid "Enter two numbers."
msgstr "შეიყვანეთ ორი რიცხვი."

msgid "Enter two valid date/times."
msgstr "შეიყვანეთ ორი სწორი თარიღი/დრო."

msgid "Enter two valid dates."
msgstr "შეიყვანეთ ორი სწორი თარიღი."

#, python-format
msgid ""
"List contains %(show_value)d item, it should contain no more than "
"%(limit_value)d."
msgid_plural ""
"List contains %(show_value)d items, it should contain no more than "
"%(limit_value)d."
msgstr[0] ""
"სია შეიცავს %(show_value)d ელემენტის. ის არ უნდა შეიცავდეს %(limit_value)d-"
"ზე მეტს."
msgstr[1] ""
"სია შეიცავს %(show_value)d ელემენტის. ის არ უნდა შეიცავდეს %(limit_value)d-"
"ზე მეტს."

#, python-format
msgid ""
"List contains %(show_value)d item, it should contain no fewer than "
"%(limit_value)d."
msgid_plural ""
"List contains %(show_value)d items, it should contain no fewer than "
"%(limit_value)d."
msgstr[0] ""
"სია შეიცავს %(show_value)d ელემენტის. ის არ უნდა შეიცავდეს %(limit_value)d-"
"ზე ნაკლებს."
msgstr[1] ""
"სია შეიცავს %(show_value)d ელემენტის. ის არ უნდა შეიცავდეს %(limit_value)d-"
"ზე ნაკლებს."

#, python-format
msgid "Some keys were missing: %(keys)s"
msgstr "აკლია ზოგიერთი გასაღები: %(keys)s"

#, python-format
msgid "Some unknown keys were provided: %(keys)s"
msgstr "მოწოდებულია რამდენიმე უცნობი გასაღები: %(keys)s"

#, python-format
msgid ""
"Ensure that the upper bound of the range is not greater than %(limit_value)s."
msgstr "დარწმუნდით, რომ შუალედის ზედა ზღვარი %(limit_value)s-ზე მეტი არაა."

#, python-format
msgid ""
"Ensure that the lower bound of the range is not less than %(limit_value)s."
msgstr "დარწმუნდით, რომ შუალედის ქვედა ზღვარი %(limit_value)s-ზე ნაკლები არაა."
